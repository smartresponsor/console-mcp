# Install root:console-mcp mode 0640. Use the same token in console-mcp.env.
BROWSER_MCP_BROWSER_WORKER_TOKEN=
BROWSER_MCP_WORKER_PORT=8791
BROWSER_MCP_HEADLESS=false
BROWSER_MCP_BROWSER_CHANNEL=msedge
BROWSER_MCP_EXTERNAL_VISIBLE_BROWSER=true
BROWSER_MCP_REMOTE_DEBUGGING_PORT=9223
BROWSER_MCP_USER_DATA_DIR=/var/lib/console-mcp-browser/edge-profile
BROWSER_MCP_APPROVAL_RECEIPT_ROOT=/var/lib/browser-mcp/approval-receipts
BROWSER_MCP_UPLOAD_ROOT=/var/lib/browser-mcp/artifacts/uploads
BROWSER_MCP_ENABLE_SUBMIT=false
