# Install as /etc/console-mcp/console-mcp.env. Keep this file root-readable only.
CONSOLE_MCP_MANAGED_RUNTIME=systemd
CONSOLE_MCP_WORKSPACE_ROOT=/srv/console-workspace
CONSOLE_MCP_TRANSCRIPT_DIR=/var/lib/console-mcp/transcript
CONSOLE_MCP_HOST=127.0.0.1
CONSOLE_MCP_TRACE=1
CONSOLE_MCP_OAUTH_DEBUG=1

# The unified service opens both legal listeners. Do not change their authority.
CONSOLE_MCP_PORT=3333
CONSOLE_MCP_PUBLIC_ORIGIN=https://console-mcp.smartresponsor.com
CONSOLE_MCP_OAUTH_ISSUER=
CONSOLE_MCP_OAUTH_AUDIENCE=https://console-mcp.smartresponsor.com
CONSOLE_MCP_OAUTH_REQUIRED_SCOPE=console:read
CONSOLE_MCP_OAUTH_READ_SCOPE=console:read
CONSOLE_MCP_OAUTH_WRITE_SCOPE=console:write
CONSOLE_MCP_OAUTH_JWKS_URI=

# Required for the localhost-only Codex listener on 127.0.0.1:3334.
CONSOLE_MCP_BEARER_TOKEN=

# This list intentionally uses semicolons on every OS because ConsolePolicy parses one portable format.
CONSOLE_MCP_EXTRA_ALLOWED_ROOTS=
