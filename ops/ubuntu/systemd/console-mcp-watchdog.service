[Unit]
Description=Console MCP health watchdog
After=network-online.target console-mcp.service console-mcp-browser.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/console-mcp/console-mcp.env
EnvironmentFile=-/etc/console-mcp/browser.env
WorkingDirectory=/home/alex/smartresponse/mcp/console-mcp
ExecStart=/home/alex/smartresponse/mcp/console-mcp/ops/ubuntu/script/watchdog.sh
User=root
Group=root
TimeoutStartSec=45s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/console-mcp /home/alex/smartresponse/mcp/console-mcp/var/run /home/alex/smartresponse/mcp/console-mcp/var/log
BindPaths=/var/lib/console-mcp/run:/home/alex/smartresponse/mcp/console-mcp/var/run /var/lib/console-mcp/log:/home/alex/smartresponse/mcp/console-mcp/var/log
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_SYS_RESOURCE
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_SYS_RESOURCE
