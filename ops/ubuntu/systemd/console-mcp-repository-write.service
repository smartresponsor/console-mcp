[Unit]
Description=Console MCP repository writable execution worker
After=local-fs.target

[Service]
Type=simple
User=console-mcp
Group=smartresponse
WorkingDirectory=/home/alex/smartresponse/mcp/console-mcp
Environment=CONSOLE_MCP_REPO_WRITE_SOCKET=/run/console-mcp-repo-write/worker.sock
Environment=CONSOLE_MCP_REPO_WRITE_POLICY_ROOT=/home/alex/smartresponse/mcp/console-mcp
ExecStart=/usr/bin/node /home/alex/smartresponse/mcp/console-mcp/dist/cli/repository-write-worker.js
RuntimeDirectory=console-mcp-repo-write
RuntimeDirectoryMode=0770
UMask=0007
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/home/alex/smartresponse /var/lib/console-mcp /run/console-mcp-repo-write
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
