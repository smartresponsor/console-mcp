[Unit]
Description=Console MCP unified runtime
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=console-mcp
Group=console-mcp
WorkingDirectory=/opt/console-mcp
EnvironmentFile=/etc/console-mcp/console-mcp.env
ExecStart=/usr/bin/node --enable-source-maps /opt/console-mcp/dist/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
StateDirectory=console-mcp
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/console-mcp
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
