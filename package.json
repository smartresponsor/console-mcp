{
  "name": "console-mcp",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "smoke": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/smoke-test.ps1",
    "smoke:oauth": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/oauth-smoke-test.ps1",
    "smoke:public": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 smoke-public",
    "smoke:local-chatgpt": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 smoke-local-chatgpt",
    "smoke:local-codex": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 smoke-local-codex",
    "smoke:admission": "node tool/chatgpt-admission-smoke.mjs",
    "schema:validate": "node tool/validate-console-tool-catalog.mjs && node tool/chatgpt-adopt-schema-regression.mjs",
    "test": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/console-mcp-regression.ps1 && pwsh -NoProfile -ExecutionPolicy Bypass -File tool/cmcp-cli-regression.ps1",
    "test:console": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/console-mcp-regression.ps1",
    "test:task-binding": "npm run build && node tool/chatgpt-task-binding-regression.mjs",
    "dev:doctor": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 doctor",
    "dev:doctor-json": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 doctor-json",
    "dev:check-prereq": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 check-prereq",
    "dev:check-config": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 check-config",
    "dev:check-cloudflared": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 check-cloudflared",
    "dev:check-autostart": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 check-autostart",
    "dev:pre-signout": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 pre-signout",
    "dev:post-login": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 post-login",
    "dev:status": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 status",
    "dev:chatgpt": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 start-chatgpt-oauth",
    "dev:codex": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 start-codex-bearer",
    "dev:stop-server": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 stop-server",
    "dev:watchdog-heal": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 watchdog-heal",
    "dev:watchdog-status": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 watchdog-status",
    "dev:watchdog-loop-start": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 start-watchdog-loop",
    "dev:watchdog-loop-restart": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 restart-watchdog-loop",
    "dev:watchdog-loop-status": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 watchdog-loop-status",
    "dev:watchdog-install": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 install-watchdog-task",
    "dev:watchdog-show": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 show-watchdog-task",
    "dev:task-install": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 install-startup-task",
    "dev:task-uninstall": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 uninstall-startup-task",
    "dev:task-show": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 show-startup-task",
    "dev:shortcuts-create": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 create-shortcuts",
    "dev:shortcuts-remove": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 remove-shortcuts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "engine": "node --enable-source-maps dist/engine/engine-cli.js",
    "engine:status": "node --enable-source-maps dist/engine/engine-cli.js status",
    "engine:tick": "node --enable-source-maps dist/engine/engine-cli.js tick",
    "engine:loop": "node --enable-source-maps dist/engine/engine-cli.js loop --max-ticks=7",
    "dev:stop": "pwsh -NoProfile -ExecutionPolicy Bypass -File tool/dev-console.ps1 stop-server"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.1",
    "jose": "^6.1.3",
    "sql.js": "^1.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "typescript": "^5.9.2"
  }
}
