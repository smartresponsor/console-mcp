{
  "schemaVersion": 1,
  "id": "console-tool-admission-overrides",
  "defaults": {
    "kind": "atomic",
    "lifecycle": "admitted"
  },
  "overrides": {
    "read_.browser.chatgpt.plugin.settings.cleanup.preview": {
      "kind": "runtimeMaintenance"
    },
    "read_.browser.chatgpt.run.loop.daemon.log.tail": {
      "kind": "orchestrationControl"
    },
    "read_.browser.chatgpt.run.loop.daemon.status": {
      "kind": "orchestrationControl"
    },
    "read_.browser.chatgpt.run.loop.recover.plan": {
      "kind": "orchestrationControl"
    },
    "read_.browser.schema.refresh.plan": {
      "kind": "runtimeMaintenance"
    },
    "read_.engine.task.handoff": {
      "kind": "domainCapability"
    },
    "read_.web.capability.contract": {
      "kind": "domainCapability"
    },
    "read_.policy.implementation.admission": {
      "lifecycle": "retired"
    },
    "read_.policy.runtime.capacity": {
      "lifecycle": "retired"
    },
    "read_.system.console.restart.plan": {
      "lifecycle": "retired"
    },
    "write.browser.chatgpt.chat.adopt_go": {
      "kind": "recipe",
      "lexicalException": true,
      "justification": "Human/runner ADOPT GO recipe name is a stable orchestration command and is intentionally outside model-facing capability naming."
    },
    "write.browser.chatgpt.plugin.settings.cleanup": {
      "kind": "runtimeMaintenance"
    },
    "write.browser.schema.refresh.execute": {
      "kind": "runtimeMaintenance"
    },
    "write.browser.session.cmcp.go": {
      "kind": "recipe"
    },
    "write.browser.session.run.loop.daemon.start": {
      "kind": "orchestrationControl"
    },
    "write.browser.session.run.loop.daemon.stop": {
      "kind": "orchestrationControl"
    },
    "write.browser.session.run.loop.recover.prune.missing": {
      "kind": "orchestrationControl"
    },
    "write.browser.session.run.loop.recover.step": {
      "kind": "orchestrationControl"
    },
    "write.engine.chat.adopt": {
      "kind": "domainCapability"
    },
    "write.engine.consumer.bind": {
      "kind": "domainCapability"
    },
    "write.engine.cycle.rounds.run": {
      "kind": "domainCapability"
    },
    "write.git.repo.fast_forward": {
      "lexicalException": true,
      "justification": "Git fast-forward is a stable peer-repo operation name introduced with the git.repo tool family; preserve the existing registered name during admission projection."
    },
    "write.web.form.fill": {
      "kind": "domainCapability"
    },
    "write.web.form.proposal.preview": {
      "kind": "domainCapability"
    },
    "write.web.form.review.snapshot": {
      "kind": "domainCapability"
    },
    "write.web.form.submit": {
      "kind": "domainCapability"
    },
    "write.web.form.upload": {
      "kind": "domainCapability"
    },
    "write.repo.quality.inspect": {
      "kind": "domainCapability"
    },
    "write.system.console.self.restart": {
      "kind": "runtimeMaintenance",
      "lifecycle": "retired"
    }
  }
}
